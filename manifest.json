{
  "manifest_version": 3,
  "name": "ChatTrimmer",
  "version": "1.1.0",
  "description": "Gấp tin nhắn cũ trong ChatGPT để cuộc trò chuyện dài không còn lag.",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],

  "content_scripts": [{
    "matches": [
      "https://chatgpt.com/*",
      "https://chat.openai.com/*"
    ],
    "js": ["src/content.js"],
    "css": ["styles.css"],
    "run_at": "document_idle"
  }],

  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatTrimmer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
