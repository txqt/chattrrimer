{
  "manifest_version": 3,
  "name": "ChatTrimmer",
  "version": "1.0.0",
  "description": "Giữ cuộc trò chuyện AI nhẹ và mượt: tự động ẩn tin nhắn cũ trên ChatGPT, Claude, Grok, Google AI Studio.",

  "permissions": [
    "storage",
    "activeTab"
  ],

  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://grok.com/*",
    "https://aistudio.google.com/*"
  ],

  "content_scripts": [{
    "matches": [
      "https://chat.openai.com/*",
      "https://chatgpt.com/*",
      "https://claude.ai/*",
      "https://grok.com/*",
      "https://aistudio.google.com/*"
    ],
    "js": ["src/content.js"],
    "css": ["styles.css"],
    "run_at": "document_idle"
  }],

  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatTrimmer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
